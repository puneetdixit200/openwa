{
  "name": "whatsapp-placement-collector",
  "version": "1.0.0",
  "private": true,
  "description": "Local, privacy-aware WhatsApp placement message collector",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "groups:list": "tsx src/index.ts --list-groups",
    "git:sync": "tsx src/index.ts --git-sync",
    "status": "tsx src/index.ts --status",
    "validate:data": "tsx src/index.ts --validate-data",
    "validate:day": "tsx src/index.ts --validate-day",
    "repair:manifest": "tsx src/index.ts --repair-manifest"
  },
  "dependencies": {
    "@open-wa/wa-automate": "4.76.0",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@typescript-eslint/eslint-plugin": "^8.24.0",
    "@typescript-eslint/parser": "^8.24.0",
    "eslint": "^9.20.1",
    "prettier": "^3.5.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.7"
  }
}
