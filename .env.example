NODE_ENV=development
TIMEZONE=Asia/Kolkata
OPENWA_SESSION_ID=placement-listener
OPENWA_HEADLESS=false
OPENWA_QR_TIMEOUT=0
OPENWA_AUTH_TIMEOUT=0
OPENWA_BROWSER_PATH=
OPENWA_CUSTOM_USER_AGENT=
OPENWA_SESSION_DIRECTORY=./.local-session
OPENWA_AUTO_RECONNECT=true
OPENWA_RECONNECT_INITIAL_SECONDS=30
OPENWA_RECONNECT_MAX_SECONDS=900
OPENWA_RECONNECT_MULTIPLIER=2
OPENWA_RECONNECT_JITTER_SECONDS=10
OPENWA_BACKGROUND_AUTH_MODE=existing-session-only
ALLOWED_GROUP_IDS=
ALLOWED_GROUP_NAMES=
DATA_REPOSITORY_PATH=/absolute/path/to/private-placement-data-repository
DATA_DIRECTORY=/absolute/path/to/private-placement-data-repository/incoming
RUNTIME_DIRECTORY=./runtime
LOG_DIRECTORY=./logs
HASH_SALT=replace-with-a-long-random-secret-at-least-32-characters
DOWNLOAD_ATTACHMENTS=true
MAX_ATTACHMENT_SIZE_MB=25
GIT_SYNC_ENABLED=false
LOCAL_ONLY_MODE=true
GIT_BRANCH=main
GIT_REMOTE=origin
GIT_SYNC_INTERVAL_MINUTES=120
GIT_COMMIT_AUTHOR_NAME=Placement Collector
GIT_COMMIT_AUTHOR_EMAIL=collector@example.com
HEALTH_SERVER_ENABLED=true
HEALTH_SERVER_HOST=127.0.0.1
HEALTH_SERVER_PORT=3100
EMIT_UNREAD_MESSAGES_ON_START=true
MESSAGE_TEXT_PRIVACY_MODE=preserve
PRESERVE_DISPLAY_NAMES=true
LOG_LEVEL=info
